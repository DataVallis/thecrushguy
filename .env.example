# Copy to .env.local for local dev. NEVER commit real values.
# Runtime environment: local | dev | prod  (only prod is indexable; no uat, ADR-016)
APP_ENV=local
# Public base URL of this environment
SITE_URL=http://localhost:3000
# Postgres connection string (local: matches docker-compose.yml)
DATABASE_URL=postgres://tcg:tcg_local_only@localhost:5432/thecrushguy
DATABASE_POOL_MAX=10
# Set by CI/deploy, shown in /api/health
GIT_SHA=
# Apply drizzle/ migrations when the server starts (deploy sets 1; locally use `npm run db:migrate`)
RUN_MIGRATIONS=0
# AES-256-GCM key for affiliate URLs: `openssl rand -base64 32` (needed from TASK-011d)
LINK_ENCRYPTION_KEY=
