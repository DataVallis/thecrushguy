{
  "$description": "The Crush Guy design tokens (TASK-003, palette A 'Midnight coral', owner 2026-10-29, ADR-029). Source of truth: src/app/globals.css @theme must match (test: src/lib/design/tokens.test.ts).",
  "color": {
    "ink": { "value": "#1b1530", "use": "text, dark surfaces, score badge" },
    "ink-soft": { "value": "#3d3550", "use": "secondary dark surfaces" },
    "muted": { "value": "#5a5370", "use": "secondary text" },
    "coral": { "value": "#ff4d6d", "use": "logo heart, score bars, decoration — never for small text or as a background behind white text" },
    "coral-strong": { "value": "#c81e45", "use": "text accents on light backgrounds" },
    "cta": { "value": "#c81e45", "use": "primary CTA background (white text)" },
    "cta-hover": { "value": "#a8163a", "use": "primary CTA hover" },
    "blush": { "value": "#ffe4ea", "use": "chips, avatar tiles, soft highlights" },
    "paper": { "value": "#fff8f9", "use": "page background" },
    "lavender": { "value": "#f3f0fa", "use": "bands, footer" },
    "success": { "value": "#047857", "use": "pros, positive states" },
    "warning": { "value": "#b45309", "use": "stale / caution" },
    "danger": { "value": "#b91c1c", "use": "errors" },
    "info": { "value": "#1d4ed8", "use": "links in notices" }
  },
  "font": {
    "display": { "value": "\"Fraunces\", ui-serif, Georgia, serif", "use": "headings, wordmark, scores (ADR-023)" },
    "sans": { "value": "\"Onest\", ui-sans-serif, system-ui, sans-serif", "use": "body, UI (ADR-023)" }
  },
  "radius": {
    "card": { "value": "1rem" },
    "tile": { "value": "1rem" },
    "pill": { "value": "9999px" }
  },
  "contrast": {
    "$description": "Text/background pairs used in the UI. Each must reach WCAG AA (4.5:1 normal text); checked by the test.",
    "pairs": [
      ["ink", "paper"],
      ["ink", "blush"],
      ["ink", "lavender"],
      ["muted", "paper"],
      ["muted", "lavender"],
      ["muted", "blush"],
      ["coral-strong", "paper"],
      ["coral-strong", "blush"],
      ["#ffffff", "cta"],
      ["#ffffff", "cta-hover"],
      ["#ffffff", "ink"],
      ["success", "#ffffff"],
      ["warning", "#ffffff"],
      ["danger", "#ffffff"],
      ["info", "#ffffff"]
    ]
  }
}
